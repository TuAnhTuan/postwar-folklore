# ── DATABASE ──
DATABASE_URL=jdbc:postgresql://localhost:5432/postwarfolklore
DATABASE_USERNAME=pwf_user
DATABASE_PASSWORD=your_password

# ── FIREBASE ──
# Option 1 (local dev): đường dẫn đến file service account JSON
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Option 2 (Render): nội dung JSON dưới dạng string (dùng khi deploy)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ── CLOUDINARY ──
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── AI ──
GEMINI_API_KEY=your_gemini_key
# OPENAI_API_KEY=your_openai_key  # nếu dùng OpenAI

# ── CORS ──
# Danh sách origin cho phép, cách nhau bằng dấu phẩy
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.onrender.com
